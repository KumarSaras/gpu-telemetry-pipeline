{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "images",
    "queue",
    "collector",
    "streamer",
    "database"
  ],
  "properties": {
    "images": {
      "type": "object",
      "required": [
        "prefix",
        "tag"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "queue": {
      "type": "object",
      "properties": {
        "replicas": {
          "const": 1
        },
        "maxMessages": {
          "type": "integer",
          "minimum": 1
        },
        "maxSlots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxSubscribers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024
        }
      }
    },
    "collector": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "streamer": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "loop": {
          "type": "boolean"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "postgresEnabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
